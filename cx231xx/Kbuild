# cx231xx-h831 module build — patched cx231xx subtree with the
# AVerMedia H831 (07ca:1831) board support added.
#
# Built with:   make -C $(KDIR) M=<repo>/cx231xx H831_ROOT=<repo>
# The H831_ROOT env var is provided by the top-level Makefile and
# points at the repository root so that cross-module config structs
# (mxl601.h) can be found.

obj-m  += cx231xx-h831.o
cx231xx-h831-objs := \
	cx231xx-video.o \
	cx231xx-i2c.o \
	cx231xx-cards.o \
	cx231xx-core.o \
	cx231xx-avcore.o \
	cx231xx-417.o \
	cx231xx-pcb-cfg.o \
	cx231xx-vbi.o \
	cx231xx-input.o \
	cx231xx-dvb.o

ccflags-y += -I$(src)
ccflags-y += -I$(H831_ROOT)/mxl601
ccflags-y += -I$(H831_ROOT)/dtv-inc
ccflags-y += -I$(H831_ROOT)/dtv-inc/media
ccflags-y += -I$(srctree)/drivers/media/tuners
ccflags-y += -I$(srctree)/drivers/media/dvb-frontends
